{
  "name": "@webstudio-is/sdk-components-react",
  "version": "0.0.0-webstudio-version",
  "description": "Webstudio default library for react",
  "author": "Webstudio <github@webstudio.is>",
  "homepage": "https://webstudio.is",
  "license": "AGPL-3.0-or-later",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "files": [
    "lib/*",
    "!*.{test,stories}.*"
  ],
  "exports": {
    ".": {
      "webstudio": "./src/index.ts",
      "types": "./lib/types/index.d.ts",
      "import": "./lib/index.js"
    },
    "./components": {
      "webstudio": "./src/components.ts",
      "types": "./lib/types/components.d.ts",
      "import": "./lib/components.js"
    },
    "./code-text": {
      "webstudio": "./src/code-text-highlight.tsx",
      "types": "./lib/types/code-text-highlight.d.ts",
      "import": "./lib/code-text-highlight.js"
    },
    "./metas": {
      "webstudio": "./src/metas.ts",
      "types": "./lib/types/metas.d.ts",
      "import": "./lib/metas.js"
    },
    "./hooks": {
      "webstudio": "./src/hooks.ts",
      "types": "./lib/types/hooks.d.ts",
      "import": "./lib/hooks.js"
    },
    "./markdown": {
      "webstudio": "./src/markdown.ts",
      "types": "./lib/types/markdown.d.ts",
      "import": "./lib/markdown.js"
    },
    "./templates": {
      "webstudio": "./src/templates.ts",
      "types": "./lib/types/templates.d.ts",
      "import": "./lib/templates.js"
    }
  },
  "scripts": {
    "build": "vite build --config ../../vite.sdk-components.config.ts",
    "build:args": "NODE_OPTIONS=--conditions=webstudio generate-arg-types './src/*.tsx !./src/*.stories.tsx !./src/*.test.{ts,tsx} !./src/*.ws.ts !./src/*.ws.ts !./src/*.template.tsx' && oxfmt \"**/*.props.ts\"",
    "build:stories": "tsx --conditions=webstudio src/generate-stories.ts && oxfmt \"src/__generated__/*.stories.tsx\"",
    "dts": "tsc --project tsconfig.dts.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "18.3.0-canary-14898b6a9-20240318",
    "react-dom": "18.3.0-canary-14898b6a9-20240318"
  },
  "dependencies": {
    "@react-aria/utils": "^3.27.0",
    "@shikijs/langs": "4.4.1",
    "@shikijs/themes": "4.4.1",
    "@webstudio-is/icons": "workspace:*",
    "@webstudio-is/image": "workspace:*",
    "@webstudio-is/react-sdk": "workspace:*",
    "@webstudio-is/sdk": "workspace:*",
    "await-interaction-response": "^0.0.2",
    "colord": "^2.9.3",
    "github-slugger": "2.0.0",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-frontmatter": "2.0.1",
    "mdast-util-to-string": "4.0.0",
    "micromark": "^4.0.2",
    "micromark-extension-frontmatter": "2.0.0",
    "micromark-extension-gfm": "^3.0.0",
    "sanitize-html": "2.17.6",
    "shiki": "4.4.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.2.0",
    "@types/react": "^18.2.70",
    "@types/react-dom": "^18.2.25",
    "@types/sanitize-html": "2.16.1",
    "@webstudio-is/design-system": "workspace:*",
    "@webstudio-is/generate-arg-types": "workspace:*",
    "@webstudio-is/sdk-cli": "workspace:*",
    "@webstudio-is/template": "workspace:*",
    "@webstudio-is/tsconfig": "workspace:*",
    "micromark-util-types": "2.0.2",
    "nanostores": "^0.11.3",
    "react": "18.3.0-canary-14898b6a9-20240318",
    "react-dom": "18.3.0-canary-14898b6a9-20240318",
    "vitest": "^3.1.2"
  }
}
