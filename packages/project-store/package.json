{
  "name": "@webstudio-is/project-store",
  "version": "0.0.0-webstudio-version",
  "description": "Portable storage and canonical JSON primitives",
  "author": "Webstudio <github@webstudio.is>",
  "homepage": "https://webstudio.is",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf lib && esbuild src/index.ts --outdir=lib --bundle --format=esm --packages=external",
    "dts": "tsc --project tsconfig.dts.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "canonicalize": "3.0.0"
  },
  "devDependencies": {
    "@webstudio-is/tsconfig": "workspace:*",
    "esbuild": "^0.25.3",
    "vitest": "^3.1.2"
  },
  "exports": {
    ".": {
      "webstudio": "./src/index.ts",
      "types": "./lib/types/index.d.ts",
      "import": "./lib/index.js",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "lib/**/*",
    "!*.test.*"
  ]
}
